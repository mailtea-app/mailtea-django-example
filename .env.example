# Your Mailtea API key: https://studio.mailtea.app/api-keys
MAILTEA_API_KEY=mt_pat_your_key_here

# An address on a domain you have verified in Mailtea.
MAILTEA_FROM=Acme <hello@acme.com>

# Optional. Overrides the API host, which defaults to https://api.mailtea.app.
# MAILTEA_API_BASE_URL=https://api.mailtea.app

# Django. These defaults are fine for local development; generate a real
# SECRET_KEY, set DJANGO_DEBUG=0, and narrow ALLOWED_HOSTS before deploying.
DJANGO_SECRET_KEY=dev-only-not-for-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
